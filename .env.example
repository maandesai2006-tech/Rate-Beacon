# Rate data comes from the free, keyless Xotelo API (https://xotelo.com),
# which serves TripAdvisor meta-search prices — no data-provider keys needed.

# ── Supabase (https://supabase.com, free tier) ───────────────────────────
# Project Settings → API. Use the *service_role* key: it is only ever used
# server-side in API routes and must never be exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Tenant isolation (required once more than one hotel group signs up) ──
# Every account shares one database. The anon key lets the app connect as the
# signed-in account rather than as the owner of the database, so Postgres
# itself refuses to return another account's rows — separation stops depending
# on every API route remembering to filter by account_id.
#
#   Project Settings → API → Project API keys → anon / public.
#   Safe to hold server-side; it grants nothing on its own. Copy the *revealed*
#   value, not the dashboard's hidden display — a key full of bullet characters
#   cannot go in a request header.
#
# No JWT signing secret is needed: each account has a Supabase auth user, and
# Supabase issues the token. That works on projects using the newer asymmetric
# signing keys, where a self-signed token is rejected outright.
#
# APP_SECRET (below) is also required — it derives each account's Supabase
# credentials. Set neither and the app still runs, but on the service key with
# row-level security bypassed. /api/system-check reports which mode is live
# under "Tenant isolation"; it must read "Enforced by the database" before a
# second customer is onboarded.
SUPABASE_ANON_KEY=

# ── App ──────────────────────────────────────────────────────────────────
# Set on Vercel so the daily cron endpoint is protected (Vercel sends it
# automatically as "Authorization: Bearer <CRON_SECRET>" on cron requests).
CRON_SECRET=generate-a-long-random-string

# Encrypts stored mailbox passwords for manager's-report collection.
# Any long random string; changing it invalidates saved mailbox logins.
APP_SECRET=generate-another-long-random-string

# ── Manager's-report pipeline ────────────────────────────────────────────
# Shared secret between the Cloudflare Email Worker and /api/ingest-report.
# The Worker HMACs every POST with it. Set the identical value there with
#   cd workers/email-ingest && npx wrangler secret put INGEST_SECRET
INGEST_SECRET=generate-a-third-long-random-string

# Google Gemini does two jobs, both on the free tier. It reads report PDFs the
# built-in parser cannot (scans, unfamiliar layouts), and it finds the
# TripAdvisor page for a hotel the map knows about — with Google Search
# grounding on, so the answer is a real search result rather than a recollection.
# Every id it returns is checked against the rate feed before it can join a
# competitive set, so a wrong answer costs nothing. Free key at
# https://aistudio.google.com → Get API key.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.0-flash.
GEMINI_MODEL=

# ── Optional signals ─────────────────────────────────────────────────────
# Local events near each profile (free key: developer.ticketmaster.com →
# Get Your API Key → Discovery API). Leave unset to skip events.
# Holidays (Nager.Date) and weather (Open-Meteo) need no keys.
TICKETMASTER_API_KEY=

# The map has been removed, and with it the only things these two keys were
# for: OPENWEATHER_API_KEY drew the temperature raster and TOMTOM_API_KEY drew
# traffic. Nothing reads them now. The conditions forecast on the home page
# uses Open-Meteo, which needs no key at all. Safe to delete from the
# deployment.

# ── Collection budget ────────────────────────────────────────────────────
# Ceiling on upstream price lookups per day, across every account. Date-major
# ordering means what gets cut is the far end of the horizon, never tonight.
# The tiered schedule (next 14 nights daily, 15–45 every third day, beyond
# weekly) keeps a fifty-customer deployment well under the default.
RATE_LOOKUP_BUDGET=50000

# ── Geocoding (optional) ─────────────────────────────────────────────────
# Hotels are placed with OpenStreetMap's Nominatim by default, which needs no
# key. Franchise names ("… University Area by IHG") trip it up more often than
# not, so the name is asked several ways and falls back to the town. A Google
# Geocoding key knows those names far better; set it and it is used first.
GOOGLE_MAPS_API_KEY=

# ── Assistant ────────────────────────────────────────────────────────────
# Questions per account per day. The model's free tier is shared across every
# customer, so this stops one curious afternoon spending it. Reading rates,
# reports and the compset is unaffected by the cap.
ASSISTANT_DAILY_TURNS=40
