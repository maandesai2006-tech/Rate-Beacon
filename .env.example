# ── Amadeus for Developers (https://developers.amadeus.com) ──────────────
# Create a free account → My Self-Service Workspace → Create New App → copy keys.
AMADEUS_CLIENT_ID=your_api_key_here
AMADEUS_CLIENT_SECRET=your_api_secret_here
# "test" (free sandbox, limited/cached hotel data) or "production"
# (real data; free monthly quota, requires enabling production keys in Amadeus).
AMADEUS_ENV=test

# ── Supabase (https://supabase.com, free tier) ───────────────────────────
# Project Settings → API. Use the *service_role* key: it is only ever used
# server-side in API routes and must never be exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App ──────────────────────────────────────────────────────────────────
# Optional simple password gate for the dashboard. Leave unset to disable.
APP_PASSWORD=pick-a-password
# Set on Vercel so the daily cron endpoint is protected (Vercel sends it
# automatically as "Authorization: Bearer <CRON_SECRET>" on cron requests).
CRON_SECRET=generate-a-long-random-string
