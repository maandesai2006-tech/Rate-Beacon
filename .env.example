# Rate data comes from the free, keyless Xotelo API (https://xotelo.com),
# which serves TripAdvisor meta-search prices — no data-provider keys needed.

# ── Supabase (https://supabase.com, free tier) ───────────────────────────
# Project Settings → API. Use the *service_role* key: it is only ever used
# server-side in API routes and must never be exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Tenant isolation (required once more than one hotel group signs up) ──
# Every account shares one database. These two values let the app connect as
# the signed-in account instead of as the owner of the database, so Postgres
# itself refuses to return another account's rows — separation stops depending
# on every API route remembering to filter by account_id.
#
#   SUPABASE_ANON_KEY   Project Settings → API → Project API keys → anon/public.
#                       Safe to hold server-side; it grants nothing on its own.
#   SUPABASE_JWT_SECRET Project Settings → API → JWT Settings → JWT Secret.
#                       Used to sign a one-hour token carrying the account id.
#                       Treat it like a password: anyone holding it can mint a
#                       token for any account.
#
# Leave them unset and the app still runs, but on the service key with
# row-level security bypassed. /api/system-check reports which mode is live
# under "Tenant isolation" — it must read "Enforced by the database" before
# a second customer is onboarded.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
# Set on Vercel so the daily cron endpoint is protected (Vercel sends it
# automatically as "Authorization: Bearer <CRON_SECRET>" on cron requests).
CRON_SECRET=generate-a-long-random-string

# Encrypts stored mailbox passwords for manager's-report collection.
# Any long random string; changing it invalidates saved mailbox logins.
APP_SECRET=generate-another-long-random-string

# ── Manager's-report pipeline ────────────────────────────────────────────
# Shared secret between the Cloudflare Email Worker and /api/ingest-report.
# The Worker HMACs every POST with it. Set the identical value there with
#   cd workers/email-ingest && npx wrangler secret put INGEST_SECRET
INGEST_SECRET=generate-a-third-long-random-string

# Google Gemini reads the report PDFs — free key at https://aistudio.google.com
# → Get API key. Without it the pipeline falls back to the built-in text
# parser, which handles clean digital reports but not scans.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.0-flash.
GEMINI_MODEL=

# ── Optional signals ─────────────────────────────────────────────────────
# Local events near each profile (free key: developer.ticketmaster.com →
# Get Your API Key → Discovery API). Leave unset to skip events.
# Holidays (Nager.Date) and weather (Open-Meteo) need no keys.
TICKETMASTER_API_KEY=

# Weather overlay on the map — the multicolour rasters a weather app draws.
# Free key at openweathermap.org/api. Deliberately NOT NEXT_PUBLIC: tiles are
# proxied through /api/map/weather/tile so the key never reaches the browser.
# The free plan serves current-conditions tiles; forecast tiles (which let the
# overlay animate across the timeline) need a plan that includes Maps 2.0. The
# app detects which you have and says so rather than faking motion.
OPENWEATHER_API_KEY=

# Live traffic on the map. Free key at developer.tomtom.com — register, create
# an app, and copy its key; the free tier allows 2,500 requests a day, which is
# far more than a dashboard this size uses.
#
# Deliberately NOT NEXT_PUBLIC: tiles are proxied through /api/map/traffic/tile
# so the key never reaches the browser. Without it the traffic layer stays off
# and says why, rather than drawing anything invented.
TOMTOM_API_KEY=
